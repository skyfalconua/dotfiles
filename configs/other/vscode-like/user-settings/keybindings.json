[
  // -- transform to kebab-case -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- - -
  {
    "key": "cmd+k cmd+-",
    "when": "isMac",
    "command": "editor.action.transformToKebabcase",

  },
  {
    "key": "ctrl+k ctrl+-",
    "when": "isWindows",
    "command": "editor.action.transformToKebabcase",
  },

  // -- transform to Pascalcase -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- - -
  {
    "key": "cmd+k cmd+p",
    "when": "isMac",
    "command": "runCommands",
    "args": {
      "commands": [
        "editor.action.transformToKebabcase",
        "editor.action.transformToPascalcase",
      ]
    }
  },
  {
    "key": "ctrl+k ctrl+p",
    "when": "isWindows",
    "command": "runCommands",
    "args": {
      "commands": [
        "editor.action.transformToKebabcase",
        "editor.action.transformToPascalcase",
      ]
    }
  },

  // -- transform to lowerCamelcase -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  {
    "key": "cmd+k cmd+m",
    "when": "isMac",
    "command": "runCommands",
    "args": {
      "commands": [
        "editor.action.transformToKebabcase",
        "editor.action.transformToCamelcase",
      ]
    }
  },
  {
    "key": "ctrl+k ctrl+m",
    "when": "isWindows",
    "command": "runCommands",
    "args": {
      "commands": [
        "editor.action.transformToKebabcase",
        "editor.action.transformToCamelcase",
      ]
    }
  },

  // -- transform to UPPER_SNAKE_CASE -- -- -- -- -- -- -- -- -- -- -- -- -- - -
  {
    "key": "cmd+k cmd+=",
    "when": "isMac",
    "command": "runCommands",
    "args": {
      "commands": [
        "editor.action.transformToSnakecase",
        "editor.action.transformToUppercase",
      ]
    }
  },
  {
    "key": "ctrl+k ctrl+=",
    "when": "isWindows",
    "command": "runCommands",
    "args": {
      "commands": [
        "editor.action.transformToSnakecase",
        "editor.action.transformToUppercase",
      ]
    }
  },

  // -- remove default zooming -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -
  {
    "key": "cmd+0",
    "command": "-workbench.action.zoomReset"
  },
  {
    "key": "ctrl+0",
    "command": "-workbench.action.zoomReset"
  },
  {
    "key": "cmd+=",
    "command": "-workbench.action.zoomIn"
  },
  {
    "key": "ctrl+=",
    "command": "-workbench.action.zoomIn"
  },
  {
    "key": "cmd+-",
    "command": "-workbench.action.zoomOut"
  },
  {
    "key": "ctrl+-",
    "command": "-workbench.action.zoomOut"
  },

  // -- add the same but with shift default zooming -- -- -- -- -- -- -- -- -- -
  {
    "key": "cmd+shift+0",
    "command": "workbench.action.zoomReset"
  },
  {
    "key": "ctrl+shift+0",
    "command": "workbench.action.zoomReset"
  },
  {
    "key": "cmd+shift+=",
    "command": "workbench.action.zoomIn"
  },
  {
    "key": "cmd+shift+-",
    "command": "workbench.action.zoomOut"
  },

  // -- new terminal in tab -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -
  {
    "key": "cmd+t",
    "command": "-workbench.action.quickOpen"
  },
  {
    "key": "cmd+t",
    "command": "-workbench.action.showAllSymbols"
  },
  {
    "key": "cmd+t",
    "command": "workbench.action.createTerminalEditor",
    "when": "isMac"
  },
  // - windows
  {
    "key": "ctrl+alt+t",
    "command": "-io.orta.jest.editor.run-all-tests",
  },
  {
    "key": "ctrl+alt+t",
    "when": "isWindows",
    "command": "workbench.action.createTerminalEditor",
  },

  // -- command runner -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- - -
  {
    "key": "ctrl+shift+r",
    "command": "-command-runner.run"
  },
  {
    "key": "ctrl+alt+r",
    "command": "-command-runner.runInTerminal"
  },
  {
    "key": "cmd+alt+p",
    "command": "command-runner.run",
    "when": "isMac"
  },
  // - windows
  {
    "key": "ctrl+alt+p",
    "command": "-svgPreview.showPreviewToSide",
  },
  {
    "key": "ctrl+alt+p",
    "command": "command-runner.run",
    "when": "isWindows"
  },
]
